{
    "name": "lazygate",
    "version": "1.0.0",
    "description": "Lazy-loading MCP broker for Claude Code",
    "license": "MIT",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "lazygate": "./dist/index.js"
    },
    "files": [
        "dist",
        "!dist/**/__tests__",
        "!dist/**/*.map",
        "config",
        "scripts",
        "docs"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/micaelmalta/lazygate.git"
    },
    "homepage": "https://github.com/micaelmalta/lazygate",
    "bugs": {
        "url": "https://github.com/micaelmalta/lazygate/issues"
    },
    "scripts": {
        "clean": "node --eval \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
        "build": "tsc",
        "dev": "tsx src/index.ts",
        "start": "node dist/index.js",
        "migrate": "node dist/index.js migrate",
        "revert-migration": "node dist/index.js revert",
        "benchmark": "node dist/index.js benchmark",
        "benchmark:suite": "node dist/index.js benchmark --suite",
        "benchmark:ci": "node dist/index.js benchmark --suite --quick --baseline benchmarks/baseline.json",
        "benchmark:baseline": "node dist/index.js benchmark --suite --quick --write-baseline benchmarks/baseline.json",
        "benchmark:suite:merged": "node dist/index.js benchmark --suite --merged-discovery",
        "benchmark:tasks:cold": "node dist/index.js benchmark --tasks --cold-discovery",
        "pack:check": "node scripts/check-pack.mjs",
        "prepack": "npm run clean && npm run build",
        "prepublishOnly": "npm run build && npm run pack:check",
        "pretest": "tsc",
        "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/.bin/jest",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.2",
        "js-tiktoken": "^1.0.21",
        "jsonpath-plus": "^11.2.2",
        "parse5": "^8.1.0",
        "quickjs-emscripten": "^0.32.0",
        "turndown": "^7.2.4",
        "turndown-plugin-gfm": "^1.0.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.6",
        "@types/turndown": "^5.0.6",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.15",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": ">=22"
    },
    "overrides": {
        "minimatch": "^11.0.4",
        "glob": "^14.0.3"
    },
    "keywords": [
        "mcp",
        "model-context-protocol",
        "mcp-gateway",
        "mcp-proxy",
        "claude-code",
        "cursor",
        "context",
        "lazy-loading",
        "tool-discovery"
    ],
    "publishConfig": {
        "access": "public"
    }
}
